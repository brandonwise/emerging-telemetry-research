# Optional adapter overrides. The generated runner first loads the private
# .emerging-telemetry-research/config.env created by `setup init`, then this file.
# Keep credentials in the OS keyring and references in the private config file.

# Optional direct Reddit Data API. Leave unset unless Reddit has approved the app.
# The default Reddit surface uses Brave site search and needs no Reddit credential.
REDDIT_ACCESS_TOKEN_REF=
REDDIT_USER_AGENT=

# Optional direct TikTok Research API. Leave unset until TikTok approves the project and grants
# research.data.basic. Client access tokens expire after two hours; refresh them outside the agent.
TIKTOK_RESEARCH_ACCESS_TOKEN_REF=

# Bounded-agent runtime. plan disables calls, shadow records reviews, and active applies
# agent analysis to report narrative while deterministic publication gates remain final.
ETR_AGENT_MODE=plan
ETR_AGENT_ADAPTER=auto
ETR_AGENT_MODEL=
ETR_AGENT_API_KEY_REF=
ETR_AGENT_BASE_URL=https://api.openai.com/v1
ETR_AGENT_PROVIDER_NAME=openai
ETR_AGENT_TIMEOUT_SECONDS=300
ETR_AGENT_INPUT_PRICE_PER_MILLION=
ETR_AGENT_OUTPUT_PRICE_PER_MILLION=

# Optional fixed-recipient SMTP delivery. Keep the password in your platform secret store.
# Both delivery gates must be true before the sender will connect to SMTP.
EXTERNAL_DELIVERY_ENABLED=false
ETR_EMAIL_DELIVERY_ENABLED=false
ETR_EMAIL_RECIPIENT=
ETR_EMAIL_SENDER=
ETR_SMTP_HOST=
ETR_SMTP_PORT=587
ETR_SMTP_SECURITY=starttls
ETR_SMTP_USERNAME=
ETR_SMTP_PASSWORD_REF=
ETR_SMTP_TIMEOUT_SECONDS=30

# Optional read-only portal. Use a random 20+ character token for LAN mode.
ETR_PORTAL_ACCESS_TOKEN=
ETR_PORTAL_ANALYTICS_DB=state/research.db
ETR_PORTAL_REPORTS_ROOT=reports/generated
