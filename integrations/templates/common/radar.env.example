# Required for live discovery. Put real values in your platform secret store.
BRAVE_API_KEY=
BRAVE_API_KEY_REF=
XAI_API_KEY=
XAI_API_KEY_REF=

# Optional direct Reddit Data API. Leave unset unless Reddit has approved the app.
# The default Reddit surface uses Brave site search and needs no Reddit credential.
REDDIT_ACCESS_TOKEN=
REDDIT_USER_AGENT=

# Optional direct TikTok Research API. Leave unset until TikTok approves the project and grants
# research.data.basic. Client access tokens expire after two hours; refresh them outside the agent.
TIKTOK_RESEARCH_ACCESS_TOKEN=

# Bounded-agent runtime. plan disables calls, shadow records reviews, and active applies
# agent analysis to report narrative while deterministic publication gates remain final.
RADAR_AGENT_MODE=shadow
RADAR_AGENT_ADAPTER=auto
RADAR_AGENT_MODEL=
RADAR_AGENT_API_KEY=
RADAR_AGENT_API_KEY_REF=
RADAR_AGENT_BASE_URL=https://api.openai.com/v1
RADAR_AGENT_PROVIDER_NAME=openai
RADAR_AGENT_TIMEOUT_SECONDS=300
RADAR_AGENT_INPUT_PRICE_PER_MILLION=
RADAR_AGENT_OUTPUT_PRICE_PER_MILLION=

# Portable local persistence.
RADAR_ANALYTICS_DB=state/radar.db
RADAR_REPORT_ROOT=reports/generated
RADAR_OBJECT_ROOT=state/objects

# Optional fixed-recipient SMTP delivery. Keep the password in your platform secret store.
# Both delivery gates must be true before the sender will connect to SMTP.
EXTERNAL_DELIVERY_ENABLED=false
RADAR_EMAIL_DELIVERY_ENABLED=false
RADAR_EMAIL_RECIPIENT=
RADAR_EMAIL_SENDER=
RADAR_SMTP_HOST=
RADAR_SMTP_PORT=587
RADAR_SMTP_SECURITY=starttls
RADAR_SMTP_USERNAME=
RADAR_SMTP_PASSWORD=
RADAR_SMTP_PASSWORD_REF=
RADAR_SMTP_TIMEOUT_SECONDS=30

# Optional read-only portal. Use a random 20+ character token for LAN mode.
RADAR_PORTAL_ACCESS_TOKEN=
RADAR_PORTAL_ANALYTICS_DB=state/radar.db
RADAR_PORTAL_REPORTS_ROOT=reports/generated
