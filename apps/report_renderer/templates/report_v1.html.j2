<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title>Threat Radar — {{ report.edition | replace('_', ' ') | title }}</title>
  <style>
    :root { color-scheme: light; --ink:#14202b; --muted:#56616c; --line:#d8dee4; --panel:#f5f7f9; --accent:#174f7a; --warn:#8a3b12; --ok:#216e39; }
    * { box-sizing:border-box; }
    body { margin:0; color:var(--ink); background:#fff; font:16px/1.5 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    main { width:min(1120px,calc(100% - 32px)); margin:0 auto; padding:36px 0 72px; }
    h1,h2,h3 { line-height:1.2; margin:0; }
    h1 { font-size:clamp(1.8rem,4vw,2.8rem); }
    h2 { font-size:1.35rem; margin-top:2rem; }
    h3 { font-size:1.15rem; }
    p { margin:.55rem 0; }
    .eyebrow { color:var(--accent); font-size:.78rem; font-weight:750; letter-spacing:.08em; text-transform:uppercase; }
    .meta,.muted { color:var(--muted); }
    .summary,.finding,.empty,.degraded { border:1px solid var(--line); border-radius:10px; padding:18px; margin-top:18px; }
    .summary,.empty { background:var(--panel); }
    .degraded { border-color:#d8a278; background:#fff7ed; color:var(--warn); }
    .finding { border-left:5px solid var(--accent); }
    .finding.flash { border-left-color:#b42318; }
    .finding.watch { border-left-color:#b7791f; }
    .score { display:inline-block; min-width:3.4rem; margin-right:.5rem; padding:.25rem .5rem; border-radius:6px; background:#e7eef4; font-weight:750; text-align:center; }
    .tags { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
    .tag { padding:3px 8px; border-radius:999px; color:#174f3f; background:#e4f1eb; font-size:.75rem; font-weight:700; }
    .sources { display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:10px; }
    .source { padding:12px; border:1px solid var(--line); border-radius:8px; background:var(--panel); }
    .source a { color:var(--accent); font-weight:700; }
    .source p { font-size:.9rem; }
    .review { border:1px solid var(--line); border-radius:10px; padding:16px; margin-top:12px; background:var(--panel); }
    .review-role { border-left:3px solid var(--accent); padding-left:12px; margin-top:14px; }
    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:12px; margin-top:14px; }
    .metric { background:var(--panel); border-radius:8px; padding:12px; }
    .metric dt { color:var(--muted); font-size:.78rem; text-transform:uppercase; letter-spacing:.04em; }
    .metric dd { margin:.2rem 0 0; font-weight:700; }
    ul { padding-left:1.25rem; }
    li + li { margin-top:.35rem; }
    code { overflow-wrap:anywhere; }
    table { width:100%; border-collapse:collapse; margin-top:12px; font-size:.92rem; }
    th,td { border-bottom:1px solid var(--line); padding:8px; text-align:left; vertical-align:top; }
    th { color:var(--muted); font-size:.75rem; letter-spacing:.04em; text-transform:uppercase; }
    .verified { color:var(--ok); font-weight:700; }
    footer { border-top:1px solid var(--line); margin-top:36px; padding-top:16px; color:var(--muted); font-size:.85rem; }
    @media (max-width:640px) { main { width:min(100% - 20px,1120px); padding-top:20px; } .summary,.finding,.empty,.degraded { padding:14px; } table { display:block; overflow-x:auto; } }
    @media print { main { width:100%; padding:0; } .finding { break-inside:avoid; } }
  </style>
</head>
<body>
<main>
  <header>
    <div class="eyebrow">Emerging Threat Radar</div>
    <h1>{{ report.edition | replace('_', ' ') | title }}</h1>
    <p class="meta">{{ report.window.start }} through {{ report.window.end }} · {{ report.window.timezone }}</p>
  </header>

  {% if report.degraded_sources %}
  <section class="degraded" aria-label="Degraded source coverage">
    <strong>Coverage gap:</strong> {{ report.degraded_sources | join(', ') }} did not complete. The report continued with the remaining evidence.
  </section>
  {% endif %}

  <section class="summary">
    <h2>Signal summary</h2>
    <p>{{ report.executive_summary or "No material emerging threats met the publication threshold." }}</p>
  </section>

  <section aria-labelledby="findings-heading">
    <h2 id="findings-heading">Findings</h2>
    {% if report.findings %}
      {% for finding in report.findings %}
      <article class="finding {{ finding.publication_class }}">
        <h3><span class="score">{{ "%.1f" | format(finding.priority_score) }}</span>{{ finding.title }}</h3>
        <p>{{ finding.why_now }}</p>
        {% if finding.get('tags', []) %}<div class="tags">{% for item in finding.get('tags', []) %}<span class="tag">{{ item | replace('_', ' ') }}</span>{% endfor %}</div>{% endif %}
        <dl class="grid">
          <div class="metric"><dt>Class</dt><dd>{{ finding.publication_class | title }}</dd></div>
          <div class="metric"><dt>Confidence</dt><dd>{{ finding.confidence.level | title }} · {{ "%.0f%%" | format(finding.confidence.probability * 100) }}</dd></div>
          <div class="metric"><dt>Stage</dt><dd>{{ finding.emergence_stage | replace('_', ' ') | title }}</dd></div>
          <div class="metric"><dt>Next check</dt><dd>{{ finding.next_check_at }}</dd></div>
        </dl>
        <h3>Known</h3>
        <ul>{% for item in finding.known %}<li>{{ item }}</li>{% endfor %}</ul>
        {% if finding.unknown %}
        <h3>Unknown</h3>
        <ul>{% for item in finding.unknown %}<li>{{ item }}</li>{% endfor %}</ul>
        {% endif %}
        {% if finding.skeptic_summary %}<p><strong>Skeptic review:</strong> {{ finding.skeptic_summary }}</p>{% endif %}
        {% if finding.defensive_actions %}
        <h3>Defensive checks</h3>
        <ul>{% for item in finding.defensive_actions %}<li>{{ item.priority | title }}: {{ item.action }}{% if item.requires_approval %} (approval required){% endif %}</li>{% endfor %}</ul>
        {% endif %}
        {% if finding.get('source_evidence', []) %}
        <h3>Where this was discovered</h3>
        <div class="sources">
          {% for source in finding.get('source_evidence', []) %}
          <div class="source">
            <a href="{{ source.url }}">{{ source.title }}</a>
            <p>{{ source.excerpt }}</p>
            <span class="muted">{{ source.source_type | replace('_', ' ') }}{% if source.source_handle %} · @{{ source.source_handle }}{% endif %}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}
        <h3>Verified claims</h3>
        <table>
          <thead><tr><th>Claim</th><th>Evidence</th><th>Status</th></tr></thead>
          <tbody>
          {% for claim in finding.claims %}
            <tr><td>{{ claim.text }}</td><td><code>{{ claim.evidence_ids | join(', ') }}</code></td><td class="verified">{{ claim.verification_status }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </article>
      {% endfor %}
    {% else %}
      <div class="empty">No material emerging threats met the publication threshold.</div>
    {% endif %}
  </section>

  {% if report.get('agent_reviews', []) %}
  <section id="agent-review">
    <h2>Bounded agent review</h2>
    {% for review in report.get('agent_reviews', []) %}
    <article class="review">
      <p><strong>{{ review.status | title }}</strong> · {{ review.mode }} mode · {{ review.duration_ms }} ms</p>
      {% for assessment in review.assessments %}
      <div class="review-role">
        <h3>{{ assessment.agent_role | replace('_', ' ') | title }}</h3>
        <p>{{ assessment.judgment }}</p>
        <p class="muted">Recommendation: {{ assessment.recommended_disposition | title }} · {{ assessment.model }}</p>
        {% if assessment.uncertainties %}<p><strong>Uncertainty:</strong> {{ assessment.uncertainties | join(' ') }}</p>{% endif %}
        {% if assessment.contradictions %}<p><strong>Contradictions:</strong> {{ assessment.contradictions | join(' ') }}</p>{% endif %}
      </div>
      {% endfor %}
      {% if review.failures %}<p class="degraded"><strong>Agent failures:</strong> {% for failure in review.failures %}{{ failure.role }}: {{ failure.error }}{% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
    </article>
    {% endfor %}
  </section>
  {% endif %}

  <section id="source-coverage">
    <h2>Source coverage</h2>
    {% set surface_metrics = {} %}
    {% for surface in report.get('discovery_telemetry', {}).get('surfaces', []) %}
      {% set _ = surface_metrics.update({surface.source_id: surface}) %}
    {% endfor %}
    <table>
      <thead><tr><th>Source</th><th>Status</th><th>Signals</th><th>Cited</th><th>Findings</th><th>Last success</th></tr></thead>
      <tbody>{% for source in report.source_health %}{% set metric = surface_metrics.get(source.source_id, {}) %}<tr><td>{{ source.source_id }}</td><td>{{ source.status }}</td><td>{{ metric.get('discovered_signal_count', 0) }}</td><td>{{ metric.get('cited_evidence_count', 0) }}</td><td>{{ metric.get('selected_finding_count', 0) }}</td><td>{{ source.last_success_at or "none" }}</td></tr>{% endfor %}</tbody>
    </table>
  </section>

  <section id="usage">
    <h2>Usage and estimated cost</h2>
    <table>
      <thead><tr><th>Stage</th><th>Surface / agent</th><th>Provider / model</th><th>Requests</th><th>Tokens</th><th>Estimated cost</th></tr></thead>
      <tbody>{% for item in report.usage %}<tr><td>{{ item.stage }}</td><td>{{ item.source_id or item.agent_id or "system" }}</td><td>{{ item.provider }} / {{ item.model }}</td><td>{{ item.requests }}</td><td>{{ item.input_tokens + item.output_tokens }}</td><td>${{ "%.4f" | format(item.estimated_currency) }}</td></tr>{% endfor %}</tbody>
    </table>
  </section>

  <footer>
    Report {{ report.report_id }} · Schema {{ report.schema_version }} · Template {{ template_revision }} · Claims verified by {{ report.verification.verifier_revision }}
  </footer>
</main>
</body>
</html>
