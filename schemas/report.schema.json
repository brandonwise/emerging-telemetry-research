{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/report.v1.json",
  "title": "Threat Radar Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "edition", "generated_at", "window", "findings", "source_health", "usage", "verification"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"type": "string", "pattern": "^rp_[A-Za-z0-9_-]+$"},
    "edition": {"enum": ["flash", "morning", "afternoon_delta", "weekly"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string"}
      }
    },
    "executive_summary": {"type": "string", "maxLength": 4000},
    "findings": {"type": "array", "maxItems": 100, "items": {"$ref": "finding.schema.json"}},
    "degraded_sources": {"type": "array", "items": {"type": "string"}},
    "source_health": {"type": "array", "items": {"$ref": "#/$defs/source_health"}},
    "usage": {"type": "array", "items": {"$ref": "#/$defs/usage"}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_claims_cited", "all_claims_verified", "verifier_revision"],
      "properties": {
        "all_claims_cited": {"type": "boolean"},
        "all_claims_verified": {"type": "boolean"},
        "verifier_revision": {"type": "string"}
      }
    }
  },
  "$defs": {
    "source_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "status", "last_success_at"],
      "properties": {
        "source_id": {"type": "string"},
        "status": {"enum": ["healthy", "degraded", "failed", "disabled"]},
        "last_success_at": {"type": ["string", "null"], "format": "date-time"},
        "freshness_seconds": {"type": ["integer", "null"], "minimum": 0},
        "error_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "provider", "model", "requests", "input_tokens", "output_tokens", "estimated_currency"],
      "properties": {
        "stage": {"type": "string"},
        "agent_id": {"type": ["string", "null"]},
        "source_id": {"type": ["string", "null"]},
        "finding_id": {"type": ["string", "null"]},
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "requests": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_currency": {"type": "number", "minimum": 0}
      }
    }
  }
}
