{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/report.v1.json",
  "title": "Threat Radar Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "edition", "generated_at", "window", "findings", "source_health", "usage", "verification"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"type": "string", "pattern": "^rp_[A-Za-z0-9_-]+$"},
    "edition": {"enum": ["flash", "morning", "afternoon_delta", "weekly"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string"}
      }
    },
    "executive_summary": {"type": "string", "maxLength": 4000},
    "findings": {"type": "array", "maxItems": 100, "items": {"$ref": "finding.schema.json"}},
    "degraded_sources": {"type": "array", "items": {"type": "string"}},
    "source_health": {"type": "array", "items": {"$ref": "#/$defs/source_health"}},
    "discovery_telemetry": {"$ref": "#/$defs/discovery_telemetry"},
    "usage": {"type": "array", "items": {"$ref": "#/$defs/usage"}},
    "semantic_shadow": {"$ref": "#/$defs/semantic_shadow"},
    "agent_shadow_plans": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/agent_shadow_plan"}
    },
    "agent_reviews": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/agent_review"}
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_claims_cited", "all_claims_verified", "verifier_revision"],
      "properties": {
        "all_claims_cited": {"type": "boolean"},
        "all_claims_verified": {"type": "boolean"},
        "verifier_revision": {"type": "string"}
      }
    }
  },
  "$defs": {
    "discovery_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered_signal_count",
        "prepared_signal_count",
        "cited_evidence_count",
        "surfaces"
      ],
      "properties": {
        "discovered_signal_count": {"type": "integer", "minimum": 0},
        "prepared_signal_count": {"type": "integer", "minimum": 0},
        "cited_evidence_count": {"type": "integer", "minimum": 0},
        "surfaces": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/discovery_surface"}
        }
      }
    },
    "discovery_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "status",
        "requests",
        "discovered_signal_count",
        "prepared_signal_count",
        "cited_evidence_count",
        "selected_finding_count",
        "source_types"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "status": {"enum": ["healthy", "degraded", "failed", "disabled"]},
        "requests": {"type": "integer", "minimum": 0},
        "discovered_signal_count": {"type": "integer", "minimum": 0},
        "prepared_signal_count": {"type": "integer", "minimum": 0},
        "cited_evidence_count": {"type": "integer", "minimum": 0},
        "selected_finding_count": {"type": "integer", "minimum": 0},
        "source_types": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      }
    },
    "source_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "status", "last_success_at"],
      "properties": {
        "source_id": {"type": "string"},
        "status": {"enum": ["healthy", "degraded", "failed", "disabled"]},
        "last_success_at": {"type": ["string", "null"], "format": "date-time"},
        "freshness_seconds": {"type": ["integer", "null"], "minimum": 0},
        "error_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "provider", "model", "requests", "input_tokens", "output_tokens", "estimated_currency"],
      "properties": {
        "stage": {"type": "string"},
        "agent_id": {"type": ["string", "null"]},
        "source_id": {"type": ["string", "null"]},
        "finding_id": {"type": ["string", "null"]},
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "requests": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_currency": {"type": "number", "minimum": 0}
      }
    },
    "semantic_shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "provider",
        "model",
        "similarity_threshold",
        "discovered_signal_count",
        "evaluated_signal_count",
        "truncated_signal_count",
        "deterministic_pair_count",
        "candidate_pair_count",
        "overlap_pair_count",
        "semantic_only_pair_count",
        "deterministic_only_pair_count",
        "requests",
        "input_tokens",
        "duration_ms",
        "vector_dimensions",
        "failure_reason",
        "candidate_pairs",
        "publication_authority"
      ],
      "properties": {
        "mode": {"const": "shadow"},
        "status": {"enum": ["completed", "skipped", "degraded"]},
        "provider": {"const": "ollama"},
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
        },
        "similarity_threshold": {"type": "number", "minimum": 0.5, "maximum": 0.99},
        "discovered_signal_count": {"type": "integer", "minimum": 0},
        "evaluated_signal_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "truncated_signal_count": {"type": "integer", "minimum": 0},
        "deterministic_pair_count": {"type": "integer", "minimum": 0},
        "candidate_pair_count": {"type": "integer", "minimum": 0},
        "overlap_pair_count": {"type": "integer", "minimum": 0},
        "semantic_only_pair_count": {"type": "integer", "minimum": 0},
        "deterministic_only_pair_count": {"type": "integer", "minimum": 0},
        "requests": {"type": "integer", "minimum": 0, "maximum": 1},
        "input_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "vector_dimensions": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 4096
        },
        "failure_reason": {
          "type": ["string", "null"],
          "enum": [
            null,
            "insufficient_signals",
            "local_inference_unavailable",
            "response_too_large",
            "invalid_response",
            "shadow_evaluation_failed"
          ]
        },
        "candidate_pairs": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/semantic_candidate_pair"}
        },
        "publication_authority": {"const": false}
      }
    },
    "agent_shadow_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "plan_id",
        "run_id",
        "finding_id",
        "created_at",
        "graph",
        "routes",
        "input_contract",
        "output_contract",
        "raw_source_content_included",
        "dispatch_executed",
        "publication_authority"
      ],
      "properties": {
        "mode": {"const": "shadow"},
        "status": {"const": "planned"},
        "plan_id": {"type": "string", "pattern": "^ap_[A-Za-z0-9_-]+$"},
        "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_-]+$"},
        "finding_id": {"type": "string", "pattern": "^fd_[A-Za-z0-9_-]+$"},
        "created_at": {"type": "string", "format": "date-time"},
        "graph": {"$ref": "#/$defs/agent_graph"},
        "routes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/agent_route"}
        },
        "input_contract": {"const": "evidence-packet.schema.json"},
        "output_contract": {"const": "assessment.schema.json"},
        "raw_source_content_included": {"const": false},
        "dispatch_executed": {"const": false},
        "publication_authority": {"const": false}
      }
    },
    "agent_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "edges"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "enum": [
                "specialist",
                "impact",
                "skeptic",
                "citation_verifier",
                "coordinator"
              ]
            }
          }
        },
        "edges": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"}
            }
          }
        }
      }
    },
    "agent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "review_id",
        "run_id",
        "finding_id",
        "created_at",
        "graph",
        "assessments",
        "failures",
        "duration_ms",
        "raw_source_content_included",
        "dispatch_executed",
        "report_mutation_executed",
        "publication_authority"
      ],
      "properties": {
        "mode": {"enum": ["shadow", "active"]},
        "status": {"enum": ["completed", "degraded"]},
        "review_id": {"type": "string", "pattern": "^ar_[A-Za-z0-9_-]+$"},
        "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_-]+$"},
        "finding_id": {"type": "string", "pattern": "^fd_[A-Za-z0-9_-]+$"},
        "created_at": {"type": "string", "format": "date-time"},
        "graph": {"$ref": "#/$defs/agent_graph"},
        "assessments": {
          "type": "array",
          "maxItems": 5,
          "items": {"$ref": "assessment.schema.json"}
        },
        "failures": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "error"],
            "properties": {
              "role": {
                "enum": [
                  "specialist",
                  "impact",
                  "skeptic",
                  "citation_verifier",
                  "coordinator"
                ]
              },
              "error": {"type": "string", "maxLength": 500}
            }
          }
        },
        "duration_ms": {"type": "integer", "minimum": 0},
        "raw_source_content_included": {"const": false},
        "dispatch_executed": {"const": true},
        "report_mutation_executed": {"type": "boolean"},
        "publication_authority": {"const": false}
      }
    },
    "agent_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "route_name",
        "provider",
        "model",
        "harness",
        "thinking",
        "max_input_tokens",
        "max_output_tokens",
        "tools"
      ],
      "properties": {
        "role": {
          "enum": [
            "specialist",
            "impact",
            "skeptic",
            "citation_verifier",
            "coordinator"
          ]
        },
        "route_name": {
          "enum": [
            "deterministic",
            "economical_extractor",
            "balanced_analyst",
            "chief_coordinator"
          ]
        },
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "harness": {"type": ["string", "null"]},
        "thinking": {"type": ["string", "null"]},
        "max_input_tokens": {"type": ["integer", "null"], "minimum": 1},
        "max_output_tokens": {"type": ["integer", "null"], "minimum": 1},
        "tools": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "semantic_candidate_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_evidence_id",
        "right_evidence_id",
        "similarity",
        "deterministic_match"
      ],
      "properties": {
        "left_evidence_id": {"type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$"},
        "right_evidence_id": {"type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$"},
        "similarity": {"type": "number", "minimum": -1, "maximum": 1},
        "deterministic_match": {"type": "boolean"}
      }
    }
  }
}
