{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/mission-signals.v1.json",
  "title": "Mission Signal Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signals"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "signals": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "title", "url", "summary", "published_at"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "source_type": {"type": "string", "minLength": 1, "maxLength": 100},
          "title": {"type": "string", "minLength": 3, "maxLength": 240},
          "url": {"type": "string", "format": "uri"},
          "summary": {"type": "string", "minLength": 3, "maxLength": 2000},
          "published_at": {"type": ["string", "null"], "format": "date-time"},
          "source_handle": {"type": ["string", "null"], "maxLength": 120}
        }
      }
    }
  }
}
