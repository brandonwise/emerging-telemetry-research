{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/evidence-packet.v1.json",
  "title": "Evidence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "cluster_id", "generated_at", "evidence", "source_lineage"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_id": {"type": "string", "pattern": "^ep_[A-Za-z0-9_-]+$"},
    "cluster_id": {"type": "string", "pattern": "^cl_[A-Za-z0-9_-]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "policy_revision": {"type": "string"},
    "sanitizer_revision": {"type": "string"},
    "entities": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/entity"}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "source_lineage": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/lineage"}
    },
    "deterministic_features": {
      "type": "object",
      "additionalProperties": {"type": ["number", "integer", "boolean", "string", "null"]}
    },
    "preliminary_score": {"type": "number", "minimum": 0, "maximum": 100},
    "content_risk": {"enum": ["low", "medium", "high", "critical"]}
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "type", "canonical_name"],
      "properties": {
        "entity_id": {"type": "string"},
        "type": {"enum": ["cve", "ghsa", "osv", "package", "repository", "vendor", "product", "domain", "ip", "account", "organization", "indicator", "technique"]},
        "canonical_name": {"type": "string", "maxLength": 500},
        "aliases": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 500}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_id", "source_role", "canonical_uri", "retrieved_at", "published_at", "content_hash", "excerpt", "claims_supported"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$"},
        "source_id": {"type": "string"},
        "source_role": {"enum": ["direct_artifact", "authoritative_advisory", "precursor", "researcher_observation", "independent_confirmation", "media_baseline", "contradiction", "correction"]},
        "canonical_uri": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "published_at": {"type": ["string", "null"], "format": "date-time"},
        "content_hash": {"type": "string", "minLength": 32, "maxLength": 128},
        "sanitized_hash": {"type": "string", "minLength": 32, "maxLength": 128},
        "excerpt": {"type": "string", "maxLength": 12000},
        "claims_supported": {"type": "array", "maxItems": 50, "items": {"type": "string"}},
        "injection_risk": {"enum": ["low", "medium", "high", "critical"]},
        "independence_group": {"type": "string"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_evidence_id", "relationship"],
      "properties": {
        "child_evidence_id": {"type": "string"},
        "parent_evidence_id": {"type": ["string", "null"]},
        "relationship": {"enum": ["original", "quotes", "reposts", "syndicates", "links_to", "derives_from", "independent"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
